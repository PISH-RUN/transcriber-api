APP_NAME=Transcriber
NODE_ENV=development

HOST=127.0.0.1
PORT=3000

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcriber
DB_USERNAME=postgres
DB_PASSWORD=secret

# JWT (auth is not used by the transcriber MVP, kept for the starter modules)
JWT_SECRET=secretKey
JWT_EXPIRES_IN=60m

# OTP
OTP_EXPIRE_MINUTES=2

# SMS (asanak or ghasedak) — unused by the transcriber MVP
SMS_PROVIDER=asanak
SMS_BASE_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SOURCE=
SMS_API_KEY=
SMS_LINE_NUMBER=

# S3 / Object Storage (required — stores uploaded audio, processed audio and speaker sample clips)
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_ENDPOINT=

# Soniox async Speech-to-Text (required for transcription)
SONIOX_API_KEY=

# Gemini 2.5 Flash — AI proof-reading of a finished transcript (optional).
# Set ONE of these; OpenRouter takes precedence when both are present.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional model override (defaults: google/gemini-2.5-flash on OpenRouter,
# gemini-2.5-flash on Google AI Studio)
LLM_REFINE_MODEL=

# pyannoteAI speaker diarization + voiceprint identification (required for speaker detection)
PYANNOTE_API_KEY=
ENABLE_PYANNOTE_DIARIZATION=true
